# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sewsmart

# A long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Public address of this API. Upload URLs are built from it.
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# Number of reverse proxies in front of the API (0 if none). Set it behind a proxy or load
# balancer, so login limits count the caller and not the proxy.
TRUST_PROXY=0

# Comma-separated origins allowed to call the API from a browser (the admin panel). Leave empty to allow all.
CORS_ORIGINS=

# Email for password reset codes. Without SMTP_HOST the email is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SewSmart <no-reply@sewsmart.app>

# Flask virtual try-on service (tryon-service/). Without it, try-on returns 503.
# The service needs REPLICATE_API_TOKEN in its own environment (see README.md).
TRYON_SERVICE_URL=http://localhost:5000

# Live video, from cloud.livekit.io (Settings, Keys). Without these, going live and watching are
# refused with a message. Keep the secret out of git and chat.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# First admin account, created by `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
